# Copy to .env and adjust. docker compose reads .env from the repo root automatically.

# --- Origins / public URLs ---
# Browser origin of the frontend; crud-server and game-server only accept CORS
# and Socket.IO requests from this origin.
FRONTEND_ORIGIN=http://localhost:3000
# URLs the browser uses to reach the backends (must be reachable from the
# user's machine, not Docker-internal hostnames).
NEXT_PUBLIC_CRUD_API_URL=http://localhost:5001
NEXT_PUBLIC_GAME_API_URL=http://localhost:5002

# --- Auth ---
# Shared by crud-server (issues JWTs) and game-server (verifies them).
JWT_SECRET=dev-secret-change-me

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crud

# --- STUN / TURN (coturn) ---
STUN_URL=stun:localhost:3478
TURN_URL=turn:localhost:3478
TURN_USERNAME=coturn
TURN_CREDENTIAL=changeme
TURN_REALM=clashinggrounds.local

# --- Host ports ---
# Postgres/Redis are remapped because 5432/6379 are often already taken locally.
FRONTEND_HOST_PORT=3000
CRUD_SERVER_HOST_PORT=5001
GAME_SERVER_HOST_PORT=5002
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
